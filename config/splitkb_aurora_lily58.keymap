#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE   0
#define LOWER  1
#define SYSTEM 2

/* macOS shortcuts */
#define MAC_LOCK LC(LG(Q))
#define MAC_UNDO LG(Z)
#define MAC_REDO LG(LS(Z))

/*
 * Encoder.
 *
 * The shield defines the EC11 with steps = <80> and 20 triggers per rotation,
 * i.e. exactly one trigger per detent. If a click ever moves two steps (or none),
 * tune it here, e.g. `&sensors { triggers-per-rotation = <10>; };`.
 *
 * `enc_kp` is `&inc_dec_kp` with a longer tap: the stock 5 ms tap lets a fast
 * spin offer ~400 HID reports/s, more than Bluetooth can carry, and the overflow
 * then drops reports (which on macOS leaves "volume up" stuck). 10 ms halves
 * the burst rate; the .conf widens the BLE queue for the rest.
 *
 * Direction: on this build the FIRST binding fires for counter-clockwise and the
 * SECOND for clockwise. If your encoder turns the other way, swap both.
 */
/ {
    behaviors {
        enc_kp: encoder_key_press {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tap-ms = <10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC           &kp N1   &kp N2   &kp N3   &kp N4    &kp N5                                        &kp N6  &kp N7     &kp N8     &kp N9    &kp N0      &kp MINUS
&kp TAB           &kp Q    &kp W    &kp E    &kp R     &kp T                                         &kp Y   &kp U      &kp I      &kp O     &kp P       &kp BACKSLASH
&kp LEFT_CONTROL  &kp A    &kp S    &kp D    &kp F     &kp G                                         &kp H   &kp J      &kp K      &kp L     &kp SEMI    &kp SQT
&kp LSHFT         &kp Z    &kp X    &kp C    &kp V     &kp B       &kp C_PLAY_PAUSE   &kp RBKT       &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH    &kp RET
                       &kp GRAVE   &kp LEFT_ALT  &kp LEFT_COMMAND  &kp BACKSPACE      &kp SPACE          &mo LOWER   &mo SYSTEM   &kp RIGHT_ALT
            >;

            // encoder: volume, press: play/pause
            sensor-bindings = <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp F1    &kp F2      &kp F3      &kp F4      &kp F5      &kp F6                        &kp F7          &kp F8          &kp F9          &kp F10           &kp F11     &kp F12
&trans    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                        &kp N6          &kp N7          &kp N8          &kp N9            &kp N0      &kp MINUS
&trans    &kp LPAR    &kp LBKT    &kp RBKT    &kp RPAR    &none                         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW   &none       &kp EQUAL
&trans    &kp GRAVE   &none       &none       &trans      &trans    &kp C_MUTE  &none   &kp CAPSLOCK    &kp MINUS       &kp COMMA       &kp DOT           &kp SLASH   &trans
                                        &trans  &trans  &trans      &trans    &trans    &trans  &trans  &trans
            >;

            // encoder: screen brightness, press: mute
            sensor-bindings = <&enc_kp C_BRI_DN C_BRI_UP>;
        };

        system_layer {
            display-name = "SYSTEM";
            bindings = <
&bootloader  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                     &ext_power EP_TOG   &studio_unlock   &none            &none            &none            &bootloader
&none        &bt BT_DISC 0    &bt BT_DISC 1    &bt BT_DISC 2    &bt BT_DISC 3    &bt BT_DISC 4                                    &none               &none            &none            &none            &none            &none
&none        &out OUT_USB     &out OUT_BLE     &out OUT_TOG     &none            &none                                            &bt BT_PRV          &bt BT_NXT       &none            &none            &none            &none
&none        &none            &none            &none            &none            &none    &kp MAC_LOCK   &bt BT_CLR              &none               &none            &none            &none            &none            &bt BT_CLR_ALL
                                        &trans     &trans      &trans          &trans                   &trans           &trans                          &trans           &trans
            >;

            // encoder: undo / redo, press: lock the Mac
            sensor-bindings = <&enc_kp MAC_UNDO MAC_REDO>;
        };
    };
};
